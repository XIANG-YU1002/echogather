# 本機 PostgreSQL 範例：
# DATABASE_URL=postgresql+psycopg://wuwagroup:wuwagroup@localhost:5432/wuwagroup
# Supabase 範例（於 Supabase 專案 Settings > Database > Connection string 取得，將 postgresql:// 改為 postgresql+psycopg://）：
#
# 應用程式請用 Transaction pooler（port 6543）：Session pooler（5432）全專案只有
# 15 個連線，併發一高就會噴 XX_MAXCONN_SESSION。transaction mode 需搭配
# connect_args={"prepare_threshold": None}（已寫在 app/core/database.py）。
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
#
# ALEMBIC_DATABASE_URL 可留空（留空時使用 DATABASE_URL）。設定 Supabase 時建議
# 指向 Session pooler（5432），DDL 在 transaction mode 下較不穩定。
# ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://wuwagroup:wuwagroup@localhost:5432/wuwagroup
ALEMBIC_DATABASE_URL=
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 圖片儲存：一律使用 Supabase Storage，不再寫入本機磁碟。
# SUPABASE_SERVICE_ROLE_KEY 於 Supabase 專案 Settings > API 取得（屬機密，勿提交）。
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me-to-your-service-role-key
SUPABASE_STORAGE_BUCKET=media

# 註冊 Email 驗證碼寄送（Gmail SMTP）。
# SMTP_PASSWORD 請填 Google 帳戶的「應用程式密碼」（16 碼），不是 Gmail 登入密碼；
# 需先開啟兩步驟驗證才能產生，見 https://myaccount.google.com/apppasswords
# 這兩欄留空時不會真的寄信，驗證碼改為寫入後端 log，方便本機測試。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=EchoGather

# 驗證碼行為（可不填，以下為預設值）
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_CODE_RESEND_INTERVAL_SECONDS=60
VERIFICATION_CODE_DAILY_LIMIT=10
VERIFICATION_CODE_MAX_ATTEMPTS=5
