{
  // Cloudflare Workers（Static Assets 模式）部署設定。
  //
  // 前端是純靜態的 Vite 產物，這裡只是把 frontend/dist 當成靜態資源掛上去，
  // 沒有任何 Worker 程式碼。後端仍在 Render，不受影響。
  //
  // 與 GitHub Pages 並存：兩邊都會部署同一份程式碼，差別只在 base path
  // （見 frontend/vite.config.js 的 DEPLOY_BASE）。
  // Worker 名稱會成為網址的第一段：<name>.<帳號子網域>.workers.dev
  // 取 www 是為了讓網址讀起來像 www.品牌.網域，而不是 品牌.帳號名.workers.dev
  "name": "www",
  // 用 API token 部署（GitHub Actions）時 wrangler 無法自行判斷要部署到哪個帳號，
  // 必須明確指定；本機用 OAuth 登入時則會自動帶入，所以只有 CI 會踩到這個。
  // Account ID 不是機密，它本來就出現在 Cloudflare Dashboard 的網址列。
  "account_id": "78e7d5a2d00f5f8ab64f88295cfcdb26",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./frontend/dist",
    // SPA 的關鍵：找不到實體檔案時回傳 index.html 且狀態碼是 **200**，
    // 不像 GitHub Pages 只能靠 404.html（狀態碼是 404，對 SEO 不利）。
    "not_found_handling": "single-page-application"
  }
}
